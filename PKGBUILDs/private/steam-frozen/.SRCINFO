	depends = libxkbcommon-x11
	depends = lsb-release
	depends = lsof
	depends = nss
	depends = python
	depends = steam-devices
	depends = ttf-font
	depends = usbutils
	depends = vulkan-driver
	depends = vulkan-icd-loader
	depends = xdg-user-dirs
	depends = xorg-xrandr
	depends = xz
	depends = zenity
	optdepends = sruman: links the steamrt3c runtime the client needs (sruman steam link)
	optdepends = gaki: moves the library, caches and logs out of the Steam folder (gaki-cli steam relocate)
	optdepends = ntsync-autoload: for NTSync support
	optdepends = polkit: to setup SteamVR without root access
	optdepends = xdg-desktop-portal-impl: file & folder picker
	optdepends = xorg-fonts-misc: for non-latin locales
	provides = steam
	conflicts = steam
	conflicts = steam-nolib32

pkgname = steam-devices
	pkgdesc = List of devices Steam and SteamVR will want read/write permissions on
	license = MIT
	depends = udev
