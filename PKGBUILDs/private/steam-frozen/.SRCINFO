pkgname = steam-frozen
	depends = bash
	depends = coreutils
	depends = curl
	depends = dbus
	depends = desktop-file-utils
	depends = diffutils
	depends = findutils
	depends = freetype2
	depends = gdk-pixbuf2
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libxcrypt
