validpgpkeys=('BA1816EF8E75005FCF5E27A1F24AEA9FB05498B7') # linux@steampowered.com

build() {
  # 64-bit replacement for Valve's 32-bit reaper (MIT, by Plagman / Valve)
  g++ ${CPPFLAGS} ${CXXFLAGS} ${LDFLAGS} -o reaper64 reaper/reaper.cpp
}

package_steam-frozen() {
  provides=(steam)
  conflicts=(steam steam-nolib32)
  depends=(
    bash
    coreutils
    curl
    dbus
    desktop-file-utils
    diffutils
    findutils
    freetype2
    gdk-pixbuf2
    glibc
    hicolor-icon-theme
    libgcc
    libxcrypt
    libxcrypt-compat
    libxkbcommon-x11
    lsb-release
    lsof
    nss
    python
    steam-devices
    ttf-font
    usbutils
    vulkan-driver
    vulkan-icd-loader
    xdg-user-dirs
    xorg-xrandr
    xz
    zenity
  )
  optdepends=(
    'sruman: links the steamrt3c runtime the client needs (sruman steam link)'
    'gaki: moves the library, caches and logs out of the Steam folder (gaki-cli steam relocate)'
    'ntsync-autoload: for NTSync support'
    'polkit: to setup SteamVR without root access'
    'xdg-desktop-portal-impl: file & folder picker'
    'xorg-fonts-misc: for non-latin locales'
  )

  # /opt, not /usr: the client runs in a pressure-vessel container, which
  # has its own /usr but shares /opt, so the user's links resolve on both sides
  local lib="${pkgdir}/opt/steam" zip f
  install -d "${lib}"
  for zip in "${_client[@]}"; do
    bsdtar -xf "${srcdir}/${zip}" -C "${lib}"
  done
  # recreate the zips' symlinks: bsdtar gives them the zip's modes (0755),
  # which pacman records and then reports as mismatched (links are 0777)
  find "${lib}" -type l -print0 | while IFS= read -r -d '' f; do
    ln -sfn "$(readlink "$f")" "$f.new" && mv -fT "$f.new" "$f"
  done
  # Valve's zips name directory entries with backslashes
  find "${lib}" -depth -name '*\\*' -type d -empty -delete

  # runtimes are sruman's: keep only the scripts and the build the client wants
  rm -rf "${lib}/steamrt64/pv-runtime/steam-runtime-steamrt"

  # no 32-bit ELF at all
  find "${lib}" -type f -print0 | while IFS= read -r -d '' f; do
    if [[ $(head -c 5 "$f" | od -An -tx1 | tr -d ' \n') == 7f454c4601 ]]; then
      rm -f "$f"
    fi
  done
  # ubuntu12_32 is the 32-bit client's: only its 64-bit helpers and the
  # scripts stay (Miles PE32 plugins and the encrypted 32-bit x264 go)
  find "${lib}/ubuntu12_32" -type f \( -name 'libx264.so.*' -o -name 'mss*' \) -delete
  install -Dm 755 "${srcdir}/reaper64" "${lib}/steamrt64/reaper"
  # links into what was removed
  find "${lib}" -xtype l -delete
  find "${lib}" -depth -type d -empty -delete
  # the legacy stubs steam.sh links ubuntu12_32/steam-runtime/ to
  [[ -f ${lib}/ubuntu12_32/legacy-run-stub.sh ]]

  # zips carry no modes: executables are the ELFs and scripts
  chmod -R u=rwX,go=rX "${lib}"
  find "${lib}" -type f -print0 | while IFS= read -r -d '' f; do
    case $(head -c 4 "$f" | od -An -c | tr -d ' \n') in
      177ELF* | '#!'*) chmod 755 "$f" ;;
    esac
  done

  install -m 644 "${srcdir}/steam.cfg" "${lib}/steam.cfg"
  # the client takes its version from here (without it: version 0, refused)
  install -Dm 644 "${srcdir}/steam_client_steamrt64.manifest" -t "${lib}/package"
  install -Dm 755 "${srcdir}/steam-frozen.sh" "${pkgdir}/usr/bin/steam"

  cd "${srcdir}/steam-launcher"
  install -Dm 644 steam.desktop -t "${pkgdir}/usr/share/applications"
  install -Dm 644 com.valvesoftware.Steam.metainfo.xml -t "${pkgdir}/usr/share/metainfo"
  install -Dm 644 steam.6 -t "${pkgdir}/usr/share/man/man6"
  local size
  for size in 16 24 32 48 256; do
    install -Dm 644 "icons/${size}/steam.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/steam.png"
  done
  install -Dm 644 icons/48/steam_tray_mono.png \
    "${pkgdir}/usr/share/icons/hicolor/48x48/apps/steam_tray_mono.png"

  install -Dm 644 "${lib}/steam_subscriber_agreement.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm 644 "${srcdir}/reaper/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.reaper"
}

package_steam-devices() {
  pkgdesc="List of devices Steam and SteamVR will want read/write permissions on"
  license=(MIT)
  depends=(udev)

  cd "${srcdir}/steam-launcher/subprojects/steam-devices"

  install -Dm 644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm 644 60-steam-input.rules \
    "${pkgdir}/usr/lib/udev/rules.d/60-steam-input.rules"
  install -Dm 644 60-steam-vr.rules \
    "${pkgdir}/usr/lib/udev/rules.d/60-steam-vr.rules"
}

