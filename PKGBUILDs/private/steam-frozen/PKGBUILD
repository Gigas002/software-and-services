arch=('x86_64')
license=('LicenseRef-steam-subscriber-agreement')
options=(!strip !debug)
_cdn=https://client-update.steamstatic.com
# desktop file, icons and udev rules from Valve's launcher package
_launcher=1.0.0.87
_reaper_commit=fb26ffe691718ae149095b2b478ad88628463017
source=(
  "${_client[@]/#/${_cdn}/}"
  https://repo.steampowered.com/steam/archive/beta/steam_${_launcher}{.tar.gz,.dsc}
  "reaper::git+https://github.com/Plagman/reaper.git#commit=${_reaper_commit}"
  steam_client_steamrt64.manifest
  steam.cfg
  steam-frozen.sh
)
noextract=("${_client[@]}")
makedepends=(git gcc)
sha256sums=(
