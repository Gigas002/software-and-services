# Local trimmed fork of AUR dwproton-bin: WOW64-only, no lib32 deps or 32-bit host libs
# Original maintainer: Shira Nguyen <sn3446409@gmail.com>

_pkgname=dwproton
pkgname=${_pkgname}-slim-bin
_srcver=11.0-16
pkgver=${_srcver//-/_}
pkgrel=2
epoch=1
pkgdesc="Proton builds with the latest Dawn Winery fixes for gacha games, based on Proton-CachyOS."
arch=('x86_64')
url="https://dawn.wine/dawn-winery/dwproton"
license=('BSD-2-Clause' 'LGPL-2.1-only' 'Zlib' 'MIT' 'MPL-2.0' 'custom')
options=(!strip emptydirs)
provides=('proton' 'dwproton')
conflicts=('dwproton-bin')
_srcdir="${_pkgname}-${_srcver}-${CARCH}"
source=("${url}/releases/download/${_pkgname}-${_srcver}/${_srcdir}.tar.xz")
sha512sums=('37fdb1c223461bc11b1db64550266c90b75759146fbee6f9e56f5282632c8f374dba6e51f624ab8f279eb8426a2c56150ed9f4c7c4977b7741e3ebdd54601ec5')
depends=(
  bash
  coreutils
  curl
  dbus
  desktop-file-utils
  diffutils
  freetype2
  gcc-libs
  gdk-pixbuf2
  glibc
  hicolor-icon-theme
  libxcrypt
  libxcrypt-compat
  libxkbcommon-x11
  lsb-release
  lsof
  nss
  python
  rtkit
  ttf-font
  usbutils
  vulkan-driver
  vulkan-icd-loader
  xdg-user-dirs
  xorg-xrandr
  xz
)
optdepends=(
  steam
  umu-launcher-nolib32
  NTSYNC-MODULE
)

prepare() {
    sed -i -E 's/"dwproton-[^"]*"/"dwproton"/g' \
      "${srcdir}/${_srcdir}/compatibilitytool.vdf"

    # WOW64-only: drop 32-bit host (ELF) libs, keep i386-windows PE dlls.
    # Needs PROTON_USE_WOW64=1, which also makes proton skip 32-bit nvidia-libs.
    local _files="${srcdir}/${_srcdir}/files"
    rm -rf "${_files}/lib/i386-linux-gnu" \
           "${_files}/lib/wine/i386-unix"
    rm -f "${_files}"/lib/wine/nvidia-libs/*/i386-windows/*.dll.so
}

package() {
    # License
    install -d "${pkgdir}/usr/share/licenses/${pkgname}"
    mv "${srcdir}/${_srcdir}"/{PATENTS.AV1,LICENSE{,.OFL}} \
       "${pkgdir}/usr/share/licenses/${pkgname}"

    # Proton executable
    install -d "${pkgdir}/usr/share/steam/compatibilitytools.d/${_pkgname}"
    mv "${srcdir}/${_srcdir}"/* \
       "${pkgdir}/usr/share/steam/compatibilitytools.d/${_pkgname}"
}
