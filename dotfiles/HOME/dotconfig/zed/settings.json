// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled",
  },
  "auto_update": false,
  "session": {
    "trust_all_worktrees": true,
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "git_status_indicator": true,
    "dock": "left",
  },
  "outline_panel": {
    "button": false,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "file_icons": true,
    "tree_view": true,
    "dock": "left",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-5",
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
  },
  "base_keymap": "VSCode",
  "icon_theme": "Catppuccin Mocha",
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "ui_font_family": "NotoSans Nerd Font",
  "ui_font_size": 16,
  "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
  "buffer_font_size": 16,
  "theme": "Catppuccin Mocha",
  "minimap": {
    "show": "always",
    "current_line_highlight": "all",
  },
  "terminal": {
    "copy_on_select": true,
    "font_family": "CaskaydiaCove Nerd Font Mono",
    "shell": {
      "program": "nu",
    },
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "format_on_save": "on",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "enabled": true,
  },
  "journal": {
    "hour_format": "hour24",
  },
  "show_whitespaces": "all",
  "soft_wrap": "bounded",
  "preferred_line_length": 160,
}
