# Autostart — hypr/autostart.lua

# Polkit (pick one)
exec /usr/lib/polkit-kde-authentication-agent-1
# exec /usr/lib/polkit-gnome-authentication-agent-1

exec ashell
# exec blueman-applet
exec nm-applet --indicator
exec mako
# exec_always wl-paste --type text --watch cliphist store
# exec_always wl-paste --type image --watch cliphist store

# Idle — hypr/hypridle.conf (swayidle)
exec swayidle -w \
    timeout 900 'brightnessctl -s set 10' \
    resume 'brightnessctl -r' \
    before-sleep 'swaylock' \
    timeout 1800 'swaylock' \
    timeout 3600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"; brightnessctl -r'
